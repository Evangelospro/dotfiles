#!/bin/sh
# config hash: {{ include "/boot/limine.conf" | sha256sum }}
set -eu

FILE="/boot/limine.conf"

if [ ! -f "$FILE" ]; then
    echo "limine.conf not found, skipping" >&2
    exit 0
fi

if grep -qE '^remember_last_entry:[[:space:]]*yes[[:space:]]*$' "$FILE"; then
    echo "remember_last_entry is already set to yes"
elif grep -qE '^remember_last_entry:' "$FILE"; then
    echo "Updating limine.conf to set remember_last_entry to yes"
    sudo sed -i -E 's/^remember_last_entry:.*/remember_last_entry: yes/' "$FILE"
else
    printf '%s\n' 'remember_last_entry: yes' | sudo tee -a "$FILE" >/dev/null
fi
