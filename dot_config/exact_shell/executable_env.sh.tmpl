# environment.d only needs loading once per session; child shells inherit it
if [[ -z $_SHELL_ENV_LOADED ]]; then
    export _SHELL_ENV_LOADED=1
    # Export all variables
    set -a
    # Call the systemd generator that reads all files in environment.d
    source /dev/fd/0 <<EOF
$(/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator)
EOF
    set +a
fi

export skip_global_compinit=1

# vivid is a fork per shell, so keep its output in a file (delete it to regenerate)
_ls_colors_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/ls_colors"
[[ -s $_ls_colors_cache ]] || { mkdir -p "${_ls_colors_cache:h}" && vivid generate dracula >| "$_ls_colors_cache" }
export LS_COLORS=$(<"$_ls_colors_cache")
unset _ls_colors_cache
export FZF_DEFAULT_COMMAND="fd --hidden --follow --exclude .git || git ls-tree -r --name-only HEAD || rg --files --hidden --follow --glob '!.git' || find ."
export FZF_DEFAULT_OPTS='-i'


# Theming manpager
export LESS_TERMCAP_mb=$'\e[1;31m'     # begin bold
export LESS_TERMCAP_md=$'\e[1;34m'     # begin blink
export LESS_TERMCAP_so=$'\e[01;45;37m' # begin reverse video
export LESS_TERMCAP_us=$'\e[01;36m'    # begin underline
export LESS_TERMCAP_me=$'\e[0m'        # reset bold/blink
export LESS_TERMCAP_se=$'\e[0m'        # reset reverse video
export LESS_TERMCAP_ue=$'\e[0m'        # reset underline
export GROFF_NO_SGR=1                  # for konsole

[[ -o interactive ]] || unset SSH_ASKPASS SSH_ASKPASS_REQUIRE
