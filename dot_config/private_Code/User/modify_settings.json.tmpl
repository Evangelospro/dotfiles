		existing = json5.loads(existing_text) if existing_text.strip() else {}
		managed = json5.loads(managed_text)
	except Exception as exc:
		print(
			f"chezmoi: failed to parse VS Code settings.json: {exc}",
			file=sys.stderr,
		)
		sys.exit(1)

	if not isinstance(existing, dict):
		print(
			"chezmoi: existing VS Code settings.json must contain an object",
			file=sys.stderr,
		)
		sys.exit(1)

	if not isinstance(managed, dict):
		print(
			"chezmoi: managed VS Code settings must contain an object",
			file=sys.stderr,
		)
		sys.exit(1)

	merge(existing, managed)

	print(
		json.dumps(
			existing,
			indent="\t",
			ensure_ascii=False,
		)
	)


