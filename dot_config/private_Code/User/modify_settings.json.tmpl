#!/usr/bin/env python3

import json
import json5
import sys


def merge(target: dict, source: dict) -> None:
	for key, value in source.items():
		if (
			isinstance(value, dict)
			and isinstance(target.get(key), dict)
		):
			merge(target[key], value)
		else:
			target[key] = value


